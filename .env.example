# ---------------------------------------------------------------------------
# Supabase project
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma (Supabase Supavisor shared pooler)
# Runtime queries use transaction mode (port 6543).
# Schema push / migrations use session mode (port 5432).
# Get these values from Supabase Dashboard -> Project Settings -> Database.
# URL-encode special characters in the password (@ : / ? # & % +).
#
# The optional `host=<ipv4>` parameter pins the pooler's IPv4 address.
# It is only needed on networks that resolve the pooler to a synthetic
# IPv6 address (DNS64). Get a current address with:
#   nslookup aws-0-<region>.pooler.supabase.com
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require&host=<ipv4>"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&host=<ipv4>"

# ---------------------------------------------------------------------------
# Application auth
# ---------------------------------------------------------------------------
# Must be a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional. Set this to allow teacher self-registration from /register.
# Leave it empty/undefined to disable public teacher account creation.
TEACHER_INVITE_CODE=""
